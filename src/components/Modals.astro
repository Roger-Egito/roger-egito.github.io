---
// Just the modal shell. Contents come from GameDetails.astro, which the
// standalone /games/<slug>/ pages use too.
import { getCollection } from 'astro:content';
import GameDetails from './GameDetails.astro';

const games = (await getCollection('games')).sort((a, b) => b.data.order - a.data.order);
---

{
  games.map((game) => (
    <div
      class="portfolio-modal modal fade"
      id={`portfolioModal-${game.id}`}
      tabindex="-1"
      role="dialog"
      aria-hidden="true"
      data-url={`/games/${game.id}/`}
      data-title={game.data.title.replace(/<[^>]*>/g, ' ').trim()}
    >
      <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
          <div class="row">
            <div class="text-center padded-box">
              <GameDetails game={game} variant="modal" />
            </div>
          </div>
        </div>
      </div>
    </div>
  ))
}
