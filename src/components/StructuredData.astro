---
// schema.org JSON-LD. Search engines read this to understand that Roger is a person
// with a job and that these are works he made, rather than guessing from the text.
// It renders nothing on screen. https://schema.org/Person
import { site } from '../config/site';

interface Props {
  /** Extra schema objects to merge in, e.g. the CreativeWork for a game page. */
  extra?: Record<string, unknown>;
}

const { extra } = Astro.props;

const person = {
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.author,
  // Spelled out because "Egito" is also the Portuguese word for Egypt. Marking it as a
  // family name tells a search engine this is a surname, not the country.
  givenName: 'Roger',
  familyName: 'Egito',
  url: site.url,
  image: `${site.url}/android-chrome-512x512.png`,
  // Only what the banner already shows. addressCountry takes the two-letter code.
  address: {
    '@type': 'PostalAddress',
    addressRegion: site.location.region,
    addressCountry: site.location.countryCode,
  },
  jobTitle: 'Game Designer and Unity Developer',
  description: site.description,
  sameAs: site.social.map((s) => s.url),
};

// Without this, Google labels results from a github.io subdomain "GitHub", the name of
// the parent domain. It has to be on the home page to count. It's on every page here
// because that costs nothing and saves checking which page is which.
// https://developers.google.com/search/docs/appearance/site-names
const website = {
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.title,
  url: `${site.url}/`,
  author: { '@id': person['@id'] },
};

const graph = extra ? [website, person, extra] : [website, person];
---

{/* is:inline because this is data for crawlers, not a script for Astro to bundle. */}
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })}
/>
