---
// Social/CV icon row, used by the header and the footer.
import Icon from './Icon.astro';
import { site, type Link } from '../config/site';

interface Props {
  class?: string;
  /** Show the hover label. Only the hero asks for it; the footer stays quiet. */
  tips?: boolean;
}

const { class: className, tips = false } = Astro.props;

const links: Link[] = [...site.social, ...site.links];
---

<ul class:list={['social-row', className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.url}
          target="_blank"
          rel="noopener"
          class="btn-social"
          aria-label={link.label}
          data-tip={tips ? (link.tip ?? link.label) : undefined}
        >
          <Icon name={link.icon} />
        </a>
      </li>
    ))
  }
</ul>

<script>
  // The hover labels. Imported here, next to the data-tip attributes above, rather
  // than only in Header.astro — this row also renders in the footer, and the game
  // pages have a footer but no Header, so the labels had nothing driving them there.
  // Astro bundles the module once however many components ask for it.
  import '../scripts/tips';
</script>
