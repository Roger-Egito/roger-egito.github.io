---
// Social/CV icon row, used by the header and the footer.
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const links = [...site.social, ...site.links];
---

<ul class:list={['social-row', className]}>
  {
    links.map((link) => (
      <li>
        <a
          href={link.url}
          target="_blank"
          rel="noopener"
          class="btn-social"
          aria-label={link.label}
        >
          <Icon name={link.icon} />
        </a>
      </li>
    ))
  }
</ul>
