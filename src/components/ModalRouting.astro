---
// Opens the portfolio modals and keeps the URL in sync with them.
//
// Normal click opens the modal over the page and pushes /games/<slug>/ into the URL.
// Ctrl/cmd/middle click falls through to the browser and opens the standalone page.
// Back, Esc and Close all close the modal and put the URL back to /.
//
// Has to be inline since it uses the jQuery/Bootstrap globals from Scripts.astro.
---

<script is:inline>
  (function () {
    var $modals = $('.portfolio-modal');
    if (!$modals.length) return;

    var baseTitle = document.title;
    // Did we add the history entry ourselves? If not, don't call history.back() on
    // close or we'd send someone off the site entirely.
    var pushedByUs = false;

    // Plain left-click opens the modal. Anything else (new tab, etc) falls through
    // to the real link.
    $(document).on('click', '.portfolio-link', function (event) {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      if (event.which && event.which !== 1) return;

      var target = $(this).attr('data-modal-target');
      if (!target || !$(target).length) return;

      event.preventDefault();
      $(target).modal('show');
    });

    $modals.on('shown.bs.modal', function () {
      var url = $(this).attr('data-url');
      if (!url || window.location.pathname === url) return;
      history.pushState({ gameModal: true }, '', url);
      pushedByUs = true;
      document.title = $(this).attr('data-title') + ' | ' + baseTitle;
    });

    $modals.on('hidden.bs.modal', function () {
      document.title = baseTitle;
      if (!pushedByUs) return;
      pushedByUs = false;
      // Drop our entry, otherwise Back needs two presses to do anything.
      history.back();
    });

    // Back/forward while a modal is open.
    window.addEventListener('popstate', function () {
      pushedByUs = false;
      $('.portfolio-modal.in').modal('hide');
    });

    // Reset the iframe src on close, otherwise the trailer keeps playing.
    $('.modal').on('hidden.bs.modal', function () {
      var iframe = $(this).find('iframe');
      if (iframe.length) {
        var src = iframe.attr('src');
        iframe.attr('src', '');
        iframe.attr('src', src);
      }
    });
  })();
</script>
