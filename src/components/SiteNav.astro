---
// Hidden until asked for. The up key on the hero's d-pad is what reveals it, so it
// stays out of the way of a page that has never needed navigation to work.
import { site } from '../config/site';

// About opens its dialog on the homepage and goes to the /about/ page anywhere else.
// Contact goes straight to the mail client.
const links = [
  { href: '#portfolio', label: 'Portfolio' },
  { href: '/about/', label: 'About', opens: '#about-dialog' },
  { href: `mailto:${site.email}`, label: 'Contact', event: 'email-click' },
];
---

<nav id="site-nav" class="site-nav" aria-label="Sections" hidden>
  <ul>
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            data-opens={link.opens}
            data-event={link.event}
            data-event-place={link.event && 'nav'}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .site-nav {
    position: fixed;
    z-index: 20;
    top: 0;
    left: 0;
    width: 100%;
    border-bottom: 2px groove var(--color-txt);
    background-color: var(--color-bg);
    /* Slides out of sight rather than disappearing, so opening and closing reads as
       one movement. [hidden] is dropped the moment it's asked for; the transform is
       what actually animates. */
    translate: 0 -100%;
    transition: translate 0.3s ease;
  }

  .site-nav[data-open] {
    translate: 0 0;
  }

  .site-nav ul {
    display: flex;
    justify-content: center;
    gap: 2.5em;
    margin: 0;
    padding: 1.1em 0;
    list-style: none;
  }

  .site-nav a {
    color: var(--color-txt);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    /* inline-block so the lift has a box to scale; an inline element ignores transform. */
    display: inline-block;
    transition: color var(--transition), transform 0.6s ease;
  }

  .site-nav a:hover,
  .site-nav a:focus-visible {
    color: var(--color-accent);
    transform: scale(1.15);
  }

  /* Same press-and-spring as .btn. */
  .site-nav a:active {
    transform: scale(1.05);
    transition-duration: 0.08s;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
    }
  }
</style>
