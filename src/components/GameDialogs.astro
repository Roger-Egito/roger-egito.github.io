---
// One <dialog> per game. Native <dialog> gives us the focus trap, Esc-to-close,
// inertness of the page behind and the backdrop for free, which is most of what
// Bootstrap's modal plugin was doing.
import { getCollection } from 'astro:content';
import GameDetails from './GameDetails.astro';
import { pageTitle, plainText } from '../config/site';

const games = (await getCollection('games')).sort((a, b) => b.data.order - a.data.order);
---

{/* data-title carries the whole tab title, so opening a dialog reads the same as the
    game's own page. Built here rather than assembled in JS, to keep one source of truth.

    The script below is bundled by Astro and hoisted into <head> as a deferred module,
    so the behavior ships with the markup that needs it. */}
<script>
  import '../scripts/modal';
</script>

{
  games.map((game) => (
    <dialog
      id={`game-${game.id}`}
      data-url={`/games/${game.id}/`}
      data-title={pageTitle(plainText(game.data.title))}
      aria-label={plainText(game.data.title)}
    >
      <div class="sheet">
        <div class="panel">
          <GameDetails game={game} deferVideo>
            <button slot="action" type="button" class="btn" data-close>
              Close
            </button>
          </GameDetails>
        </div>
      </div>
    </dialog>
  ))
}

<style>
  /* The dialog is the full-screen overlay, not the card. It's the thing that scrolls,
     so the card itself never gets its own scrollbar and can run from the top of the
     screen off the bottom, the way the old Bootstrap modal did. */
  dialog {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-txt);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 0.5);
  }

  .sheet {
    width: min(90vw, 1000px);
    margin: 0 auto;
    border: 2px groove var(--color-txt);
    border-radius: 25px;
    background-color: var(--color-bg);
    box-shadow: 15px 15px 10px 5px rgb(0 0 0 / 0.31);
  }

  .panel {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    text-align: center;
  }

  /* Fade in, with the card sliding down like the old modal did. @starting-style is
     what lets an element animate in from display:none. */
  dialog,
  dialog::backdrop {
    transition: opacity 0.3s ease, overlay 0.3s allow-discrete, display 0.3s allow-discrete;
  }

  .sheet {
    transition: transform 0.3s ease-out;
  }

  dialog:not([open]),
  dialog:not([open])::backdrop {
    opacity: 0;
  }

  dialog:not([open]) .sheet {
    transform: translateY(-25%);
  }

  @starting-style {
    dialog[open],
    dialog[open]::backdrop {
      opacity: 0;
    }

    dialog[open] .sheet {
      transform: translateY(-25%);
    }
  }
</style>
