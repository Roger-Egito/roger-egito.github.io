---
// One <dialog> per game. Native <dialog> gives us the focus trap, Esc-to-close,
// inertness of the page behind and the backdrop for free, which is most of what
// Bootstrap's modal plugin was doing.
import { getCollection } from 'astro:content';
import GameDetails from './GameDetails.astro';
import { pageTitle, plainText } from '../config/site';

const games = (await getCollection('games')).sort((a, b) => b.data.order - a.data.order);
---

{/* data-title carries the whole tab title, so opening a dialog reads the same as the
    game's own page. Built here rather than assembled in JS, to keep one source of truth.

    The script below is bundled by Astro and hoisted into <head> as a deferred module,
    so the behavior ships with the markup that needs it. */}
<script>
  import '../scripts/modal';
</script>

{/* Asked before a running build gets dropped, since closing unloads it and any
    progress goes with it. modal.ts drives this. */}
<dialog id="confirm-close" class="confirm" aria-labelledby="confirm-close-text">
  <p id="confirm-close-text">Close the game?</p>
  <div class="confirm-actions">
    <button type="button" class="btn" data-confirm="yes">Yes</button>
    <button type="button" class="btn btn-quiet" data-confirm="no">No</button>
  </div>
</dialog>

{
  games.map((game) => (
    <dialog
      class="overlay"
      id={`game-${game.id}`}
      data-url={`/games/${game.id}/`}
      data-title={pageTitle(plainText(game.data.title))}
      aria-label={plainText(game.data.title)}
    >
      {/*
        autofocus so opening the dialog lands here rather than on the first focusable
        thing inside it, which is the YouTube iframe. Focus inside a cross-origin frame
        sends Esc to that frame's document, and the dialog never gets its cancel event
        — so Esc silently stopped closing anything.
      */}
      <div class="sheet" tabindex="-1" autofocus>
        <div class="panel">
          <GameDetails game={game} deferVideo>
            <button slot="action" type="button" class="btn" data-close>
              Close
            </button>
          </GameDetails>
        </div>
      </div>
    </dialog>
  ))
}

<style>
  /* Sits on top of the game dialog, so it needs its own box rather than the
     full-screen overlay treatment the shared .overlay styles give. */
  .confirm {
    width: min(90vw, 28rem);
    margin: auto;
    padding: var(--space-gap);
    border: 2px groove var(--color-txt);
    border-radius: 25px;
    background-color: var(--color-bg);
    color: var(--color-txt);
    text-align: center;
  }

  .confirm::backdrop {
    background: var(--color-backdrop-deep);
  }

  .confirm p {
    margin: 0 0 var(--space-gap);
    font-family: var(--font-heading), sans-serif;
    font-size: 1.5em;
    text-transform: uppercase;
  }

  .confirm-actions {
    display: flex;
    justify-content: center;
    gap: 1em;
  }

  /* "No" is the safe option, so it reads as secondary rather than a second button
     competing with "Yes". */
  .confirm .btn-quiet {
    border-color: var(--color-txt);
    background: none;
    color: var(--color-txt);
  }
</style>
