---
// The "back to Portfolio" link above a standalone page's card (a game page, /about/).
// It sits inside the page's main, on the same 900px column as the card, so the chevron
// starts exactly on the card's left border at every breakpoint.
import Icon from './Icon.astro';
---

<nav class="crumb">
  <a href="/#portfolio">
    <Icon name="angle-left" class="crumb-icon" />
    Portfolio
  </a>
</nav>

<style>
  .crumb {
    max-width: 900px;
    margin: 0 auto 20px;
  }

  .crumb a {
    /* inline-flex keeps the chevron and the word on one baseline, and the link only as
       wide as the two of them, so the hover scale doesn't take the whole column. */
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    opacity: 0.7;
    color: var(--color-txt);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    /* Grows rightward from the card's border. A centered scale would push the chevron
       back out past the edge it's aligned to. */
    transform-origin: left center;
    transition: opacity var(--transition), transform 0.6s ease;
  }

  .crumb a:hover,
  .crumb a:focus-visible {
    opacity: 1;
    transform: scale(1.15);
  }

  /* Under 1 so the press compresses past rest and springs back, the way the tabs do. */
  .crumb a:active {
    transform: scale(0.85);
    transition-duration: 0.08s;
  }

  /* :global because the <svg> comes from Icon.astro and carries that component's scope. */
  .crumb a :global(.crumb-icon) {
    width: auto;
    height: 0.9em;
    fill: currentColor;
  }
</style>
