---
// An image beside a block of text, for a game's long-form body in .mdx.
//
//   <TwoColumn image={setupScreen} alt="The settings screen" caption="Initial game settings">
//
//   Markdown text goes here. Leave a blank line after the opening tag, or MDX
//   treats the text as plain inline content and ignores the Markdown in it.
//
//   </TwoColumn>
//
// The image goes through astro:assets, so it gets resized and converted like the rest
// of the site's art. Below 768px the two columns stack, image first, since a phone
// has no room for both side by side.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  /** Describes the image for screen readers. Required, since these images carry content. */
  alt: string;
  /** Short line under the image. Optional. */
  caption?: string;
  /** Which side the image sits on at desktop widths. Alternate it down a page. */
  side?: "left" | "right";
}

const { image, alt, caption, side = "left" } = Astro.props;
---

<div class="two-column" data-side={side}>
  <figure style={`--ratio: ${image.width / image.height}`}>
    <Image
      src={image}
      alt={alt}
      widths={[480, 960]}
      sizes="(min-width: 768px) 26rem, 90vw"
      loading="lazy"
    />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
  <div class="text">
    <slot />
  </div>
</div>

<style>
  .two-column {
    display: grid;
    gap: var(--space-gap);
    align-items: center;
    margin: var(--space-gap) 0;
    text-align: left;
  }

  figure {
    margin: 0;
  }

  /* Full column width, except a portrait phone screenshot, which would tower over the
     text beside it. Its width is capped at whatever keeps it 32rem tall. The width
     stays definite so the browser reserves the image's space before it loads. */
  img {
    display: block;
    width: min(100%, 32rem * var(--ratio));
    height: auto;
    margin-inline: auto;
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 0.5em;
    color: var(--color-muted);
    font-size: 0.85em;
    text-align: center;
  }

  /* The slot's first and last paragraphs would otherwise add their own margins on top
     of the grid's, pushing the text off center next to the image. */
  .text > :global(:first-child) {
    margin-top: 0;
  }

  .text > :global(:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .two-column {
      grid-template-columns: 1fr 1fr;
    }

    /* Swap the visual order without changing the source order, so screen readers
       still meet the image before the text that talks about it. */
    .two-column[data-side="right"] figure {
      order: 2;
    }
  }
</style>
