---
// Vendor libraries from public/js/. Order matters: jQuery sets up the `$` global that
// everything below it needs. `is:inline` stops Astro turning these into ES modules,
// which would break the globals.
---

<!-- jQuery Version 1.11.0 -->
<script src="/js/jquery-1.11.0.js" is:inline></script>

<!-- Bootstrap Core JavaScript -->
<script src="/js/bootstrap.min.js" is:inline></script>

<!-- Plugin JavaScript -->
<script src="/js/jquery.easing.min.js" is:inline></script>
<script src="/js/classie.js" is:inline></script>
<script src="/js/cbpAnimatedHeader.js" is:inline></script>

<!-- Contact Form JavaScript -->
<script src="/js/jqBootstrapValidation.js" is:inline></script>
<script src="/js/contact_me_static.js" is:inline></script>

<!-- Custom Theme JavaScript -->
<script src="/js/freelancer.js" is:inline></script>
