---
/**
 * One tag's icon, wherever it came from.
 *
 * A tag in src/config/tags.ts can point `icon` at either any Font Awesome free name
 * ('unity', 'network-wired'), or a file sitting in src/assets/tags/ ('ludomancer.svg').
 * Anything containing a dot is treated as a filename, which is why Font Awesome names
 * never have one.
 *
 * The name shows on hover, the same floating label the social buttons use — tips.ts
 * picks up any [data-tip] on the page.
 */
import Icon, { type IconName } from './Icon.astro';
import type { ResolvedTag } from '../config/tags';

interface Props {
  tag: ResolvedTag;
}

const { tag } = Astro.props;

// Eager so a missing file is a build error rather than an empty box on the page, and
// so Vite hashes each one. src/assets keeps them out of the served folder until used.
const files = import.meta.glob<string>('../assets/tags/*.{svg,png,webp}', {
  eager: true,
  query: '?url',
  import: 'default',
});

const src = tag.iconIsFile ? files[`../assets/tags/${tag.icon}`] : undefined;

if (tag.iconIsFile && !src) {
  throw new Error(
    `Tag "${tag.id}" points at src/assets/tags/${tag.icon}, which doesn't exist. ` +
      `Add the file, or drop the icon from that tag in src/config/tags.ts.`
  );
}
---

<span class="tag-icon" data-tip={tag.label} aria-label={tag.label} role="img">
  {
    src ? (
      <img src={src} alt="" width="18" height="18" loading="lazy" />
    ) : (
      <Icon name={tag.icon as IconName} />
    )
  }
</span>

<style>
  .tag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Dimmed until pointed at, so a row of them reads as trim beside the date rather
       than competing with the artwork above. */
    opacity: 0.55;
    transition: opacity var(--transition), transform var(--transition);
  }

  .tag-icon:hover {
    opacity: 1;
    transform: scale(1.15);
  }

  .tag-icon :global(svg),
  .tag-icon img {
    width: auto;
    height: 16px;
    /* A logo dropped in as a colour PNG would fight the palette; this keeps every
       icon the same ink as the text around it. Remove for a tag whose colour matters. */
    filter: grayscale(1);
  }

  .tag-icon :global(svg) {
    fill: currentColor;
  }
</style>
