---
/**
 * One tag's icon, wherever it came from.
 *
 * A tag in src/config/tags.ts can point `icon` at either any Font Awesome free name
 * ('unity', 'network-wired'), or a file sitting in src/assets/tags/ ('ludomancer.svg').
 * Anything containing a dot is treated as a filename, which is why Font Awesome names
 * never have one.
 *
 * Two shapes:
 *
 *   default — a standalone glyph in the card's eyebrow. Dimmed until pointed at, and
 *             it names itself on hover, since nothing else on that row says what it is.
 *   inline  — sitting inside its own chip, where the name is already spelled out
 *             beside it. No tooltip repeating that name, no dimming, and sized to the
 *             text it sits with.
 */
import Icon, { type IconName } from './Icon.astro';
import type { ResolvedTag } from '../config/tags';

interface Props {
  tag: ResolvedTag;
  /** Set when the icon sits next to its own label, e.g. inside a chip. */
  inline?: boolean;
  /**
   * Glyph height in px, overriding the default for the variant. A studio logo is a
   * drawing rather than a symbol, so it needs a little more room than a Font Awesome
   * mark before it stops reading as a smudge.
   */
  size?: number;
}

const { tag, inline = false, size } = Astro.props;

// Eager so a missing file is a build error rather than an empty box on the page, and
// so Vite hashes each one. src/assets keeps them out of the served folder until used.
const files = import.meta.glob<string>('../assets/tags/*.{svg,png,webp}', {
  eager: true,
  query: '?url',
  import: 'default',
});

const src = tag.iconIsFile ? files[`../assets/tags/${tag.icon}`] : undefined;

if (tag.iconIsFile && !src) {
  throw new Error(
    `Tag "${tag.id}" points at src/assets/tags/${tag.icon}, which doesn't exist. ` +
      `Add the file, or drop the icon from that tag in src/config/tags.ts.`
  );
}
---

<span
  class:list={['tag-icon', inline && 'is-inline']}
  style={size ? `--icon-size: ${size}px` : undefined}
  data-tip={inline ? undefined : tag.label}
  aria-label={inline ? undefined : tag.label}
  aria-hidden={inline ? 'true' : undefined}
  role={inline ? undefined : 'img'}
>
  {
    src ? (
      <img src={src} alt="" loading="lazy" />
    ) : (
      <Icon name={tag.icon as IconName} />
    )
  }
</span>

<style>
  .tag-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Dimmed until pointed at, so a row of them reads as trim beside the date rather
       than competing with the artwork above. */
    opacity: 0.55;
    transition: opacity var(--transition), transform var(--transition);
  }

  /* Lifted well clear rather than nudged: the eye cursor is 32px square and sits right
     on top of a 16px icon, so a small bump left it just as hidden. z-index puts the
     grown icon over its neighbours instead of under them, and needs a position to
     apply at all. */
  .tag-icon:hover {
    position: relative;
    z-index: 2;
    opacity: 1;
    transform: scale(3);
  }

  .tag-icon :global(svg),
  .tag-icon img {
    width: auto;
    height: var(--icon-size, 16px);
    /* Colour is held back until you point at something. At rest the row reads as one
       set of marks in the card's own ink instead of a strip of competing brand
       palettes; on hover the logo comes up in its real colours. */
    filter: grayscale(1);
    transition: filter var(--transition);
  }

  /* Not .is-inline: a chip has no hover state of its own, so lighting up the glyph
     inside it would be the only thing reacting. */
  .tag-icon:not(.is-inline):hover :global(svg),
  .tag-icon:not(.is-inline):hover img {
    filter: grayscale(0);
  }

  .tag-icon :global(svg) {
    fill: currentColor;
  }

  /* Inside a chip the icon is a piece of punctuation next to the word, not a control
     of its own — so it takes the chip's ink and never moves. */
  .is-inline,
  .is-inline:hover {
    opacity: 1;
    transform: none;
  }

  .is-inline {
    --icon-size: 11px;
  }
</style>
