---
import { site } from '../config/site';
import SocialLinks from './SocialLinks.astro';
---

<header
  style="background-image:url('/img/bannertest2.png');background-size:100vw;background-repeat:no-repeat;"
>
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <img class="img-responsive" src="/img/profile.png" alt="profile-pic" />
        <div class="intro-text">
          <span class="name">{site.title}</span>
          <span class="skills">{site.skills}</span>
          <hr class="star-light" />
          <br />
          <span class="skills">{site.slogan}</span>
          <br />
          <SocialLinks colStyle="width: 100%; margin: auto; padding-top: 2.5em" />
        </div>
      </div>
    </div>
  </div>
</header>
