---
// Posts to Formspree. Validation is the browser's own (required, type="email"), which
// replaced a 37 KB jQuery validation plugin, and the floating labels are pure CSS, so
// this whole section ships no JavaScript.
import Icon from './Icon.astro';
import StarRule from './StarRule.astro';
import { site, contactSocial } from '../config/site';

const fields = [
  { id: 'name', name: 'name', label: 'Name', type: 'text' },
  { id: 'email', name: '_replyto', label: 'Email Address', type: 'email' },
] as const;
---

<section id="contact">
  <div class="container">
    <h2 class="section-heading">Contact Me</h2>
    <StarRule />

    <ul class="social-row contact-social">
      <li>
        <a
          href={contactSocial.url}
          target="_blank"
          rel="noopener"
          class="btn-social"
          aria-label={contactSocial.label}
        >
          <Icon name={contactSocial.icon} />
        </a>
      </li>
    </ul>

    <form action={site.contactAction} method="POST">
      {
        fields.map((field) => (
          <div class="field">
            <label for={field.id}>{field.label}</label>
            <input
              type={field.type}
              id={field.id}
              name={field.name}
              placeholder={field.label}
              required
            />
          </div>
        ))
      }

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" placeholder="Message" required></textarea>
      </div>

      <input type="hidden" name="_subject" value="New submission!" />
      {/* Honeypot: bots fill it in, people never see it. */}
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" hidden />

      <button type="submit" class="btn">Send</button>
    </form>
  </div>
</section>

<style>
  .contact-social {
    padding-bottom: 2.5em;
  }

  /* Same width and offset the old 8-of-12 column gave it. */
  form {
    margin: 0 auto;
  }

  @media (min-width: 1200px) {
    form {
      width: 750px;
    }
  }

  /* The underline runs 15px wider than the input on each side, which is what the
     old column padding did. */
  .field {
    margin: 0 -15px;
    /* 17.5px rather than 7.5px keeps the fields the height they've always been: the
       old markup carried an empty validation-message paragraph worth 10px. */
    padding: 0 15px 17.5px;
    border-bottom: 1px solid #eee;
  }

  .field:first-of-type {
    border-top: 1px solid #eee;
  }

  /* Scoped to .field on purpose: a bare `input` rule would override the browser's
     display:none on the hidden _subject field and the _gotcha honeypot, putting both
     on screen. */
  .field :is(input, textarea) {
    display: block;
    width: 100%;
    height: 43px;
    padding: 10px 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 1.5em;
    line-height: var(--line-height);
    resize: none;
  }

  .field textarea {
    height: auto;
  }

  .field :is(input, textarea):focus {
    outline: none;
  }

  /* The label sits in the flow above the input but is nudged down over it and hidden,
     then rises into place once the field has something in it. `:placeholder-shown` is
     how we know the field is empty, so this needs no JavaScript. */
  label {
    display: block;
    position: relative;
    top: 2em;
    z-index: 0;
    margin: 0;
    opacity: 0;
    font-size: 0.85em;
    line-height: 1.764705882em;
    pointer-events: none;
    transition: top var(--transition), opacity var(--transition);
  }

  .field:has(:is(input, textarea):not(:placeholder-shown)) label,
  .field:has(:is(input, textarea):focus) label {
    top: 0;
    opacity: 1;
  }

  /* `:user-invalid` only fires once someone has actually interacted, so the form
     doesn't turn red the moment it loads. */
  .field:has(:user-invalid) {
    border-bottom-color: #e74c3c;
  }

  .field:has(:user-invalid) label {
    color: #e74c3c;
  }

  /* One blank line's worth of space, which is what the <br> above the button used
     to provide. */
  button {
    margin-top: calc(var(--text-base) * var(--line-height));
    margin-bottom: 15px;
  }
</style>
