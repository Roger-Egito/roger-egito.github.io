---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import StarRule from './StarRule.astro';

// Highest order first, which matches the order the grid used to show.
const games = (await getCollection('games')).sort((a, b) => b.data.order - a.data.order);
---

<section id="portfolio">
  <div class="container">
    <h2 class="section-heading">Portfolio</h2>
    <StarRule />

    <ul class="grid">
      {
        games.map((game, i) => (
          <li>
            {/* Real href so the link still works with JS off or in a new tab.
                modal.ts catches normal clicks and opens the dialog instead. */}
            <a
              href={`/games/${game.id}/`}
              class="card"
              data-game={game.id}
              aria-haspopup="dialog"
            >
              <Image
                src={game.data.img}
                alt={game.data.alt ?? `${game.data.title.replace(/<[^>]*>/g, ' ')} key art`}
                widths={[400, 800]}
                sizes="(min-width: 60rem) 32vw, (min-width: 40rem) 49vw, 100vw"
                loading={i < 3 ? 'eager' : 'lazy'}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Same flex percentages and breakpoints the old grid used, so the columns break
     at exactly the widths they used to. */
  .grid {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    margin: 0 0 15px;
  }

  @media (min-width: 640px) {
    .grid {
      display: flex;
      flex-flow: row wrap;
      align-items: stretch;
      justify-content: space-between;
    }

    .grid > li {
      flex: 1 0 49%;
      max-width: 49%;
    }
  }

  @media (min-width: 767px) {
    .grid > li {
      margin: 0 0 30px;
    }
  }

  @media (min-width: 960px) {
    .grid > li {
      flex: 1 0 32%;
      max-width: 32%;
    }
  }

  .card {
    display: block;
    position: relative;
    max-width: 400px;
    margin: 0 auto;
    opacity: 0.5;
    transition: transform 0.6s ease, opacity 1s ease;
  }

  .card :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .card:hover,
  .card:focus-visible {
    transform: scale(1.1);
    opacity: 1;
    z-index: 1;
  }
</style>
