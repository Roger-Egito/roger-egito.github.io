---
/**
 * The full catalog: every game, filterable and searchable. The featured row above it is
 * a spotlight on three of them; this is where all of them live (see DESIGN.md).
 */
import { getCollection } from "astro:content";
import StarRule from "./StarRule.astro";
import FilterBar from "./FilterBar.astro";
import GameCard from "./GameCard.astro";
import { buildMenus } from "../config/filters";

// Highest order first, which matches the order the grid used to show.
const games = (await getCollection("games")).sort((a, b) => b.data.order - a.data.order);

// What the bar over the grid can offer, worked out from the games that exist.
const menus = buildMenus(games);
---

<script>
  import "../scripts/hover-preview";
  import "../scripts/portfolio-filter";
  // The technology icons beside the year carry data-tip, same as the social buttons.
  import "../scripts/tips";
</script>

<section id="portfolio">
  <div class="container">
    <h2 class="section-heading">Portfolio</h2>
    <StarRule />

    <FilterBar menus={menus} total={games.length} />

    <ul class="grid" data-portfolio-grid>
      {
        games.map((game) => (
          <li>
            <GameCard game={game} size="grid" filterable />
          </li>
        ))
      }
    </ul>

    {/* Only on screen once every card is filtered out. */}
    <p class="no-results" data-filter-empty hidden>
      No games match those filters.
    </p>
  </div>
</section>

<style>
  /* Smaller cards than the featured row's, and more of them to a line: size is what
     tells the spotlight apart from the catalog. Four across on a wide screen, then
     three, two and one. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 26px 20px;
    }
  }

  @media (min-width: 992px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* One column on a phone, but never wider than the cards were designed for. */
  .grid > li {
    display: flex;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .grid > li {
      max-width: none;
    }
  }

  /* A card's detail panel hangs over the row below it, so the card being looked at has
     to sit above its neighbours, which would otherwise paint over it by coming later. */
  .grid > li:hover,
  .grid > li:has(:focus-visible) {
    z-index: 4;
  }

  /* Filtered out. The rule above sets a display, and a display beats the hidden
     attribute, so a card the filter had dropped stayed right where it was. */
  .grid > li[hidden] {
    display: none;
  }

  .no-results {
    margin: 30px 0 0;
    color: var(--color-muted);
    text-align: center;
  }

  .no-results[hidden] {
    display: none;
  }
</style>
