---
// The old footer had a big commented-out "footer-above" block (location / social /
// credits columns). Dropped it since it was dead markup; `git show b5fba5c` has it.
import { site } from '../config/site';
import SocialLinks from './SocialLinks.astro';
---

<footer class="text-center">
  <div class="footer-below">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">{site.footerNote}</div>
        <div class="row">
          <SocialLinks
            colStyle="width: 100%; margin: auto; padding-top: 1em; text-align: center"
          />
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- Scroll to Top Button (Only visible on small and extra-small screen sizes) -->
<div class="scroll-top page-scroll visible-xs visible-sm">
  <a class="btn btn-primary" href="#page-top">
    <i class="fa fa-chevron-up"></i>
  </a>
</div>
