---
// The old footer had a big commented-out "footer-above" block (location / social /
// credits columns). Dropped it since it was dead markup; `git show b5fba5c` has it.
import SocialLinks from './SocialLinks.astro';
import { site } from '../config/site';
---

<footer>
  <div class="container">
    <p>{site.footerNote}</p>
    <SocialLinks />
  </div>
</footer>

<style>
  footer {
    padding: 25px 0;
    background-color: var(--color-surface);
    text-align: center;
  }

  p {
    margin: 0 0 1em;
    font-size: var(--text-base);
  }
</style>
