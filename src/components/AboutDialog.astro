---
// The about text as a dialog over the homepage, opened from the name in the hero and
// from the nav. Like the game dialogs, it puts its own page's URL, /about/, in the
// address bar (src/scripts/modal.ts), so the visit is counted and the link can be
// shared. The overlay and card styles are in global.css, shared with the game dialogs.
import StarRule from './StarRule.astro';
import AboutCopy from './AboutCopy.astro';
import { pageTitle } from '../config/site';
---

<dialog class="overlay" id="about-dialog" aria-label="About Roger Egito" data-url="/about/" data-title={pageTitle('About')}>
  <div class="sheet" tabindex="-1">
    <div class="panel">
      <h2 class="section-heading">About</h2>
      <StarRule />
      <AboutCopy />
      <button type="button" class="btn" data-close>Close</button>
    </div>
  </div>
</dialog>
