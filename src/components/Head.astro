---
import { Font } from 'astro:assets';
import { site } from '../config/site';
import { colors, colorVariables } from '../config/theme';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image for link previews. */
  image?: string;
  /** Asks search engines to leave the page out of their results. */
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  image,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const preview = image ? new URL(image, site.url).href : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

{/* The whole palette, straight from src/config/theme.ts. is:inline keeps Astro from
    scoping it to this component, which :root would not survive. It goes ahead of the
    stylesheets so nothing is ever painted before the colors exist. */}
<style is:inline set:html={colorVariables}></style>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />

<Font cssVariable="--font-heading" preload />
<Font cssVariable="--font-body" preload />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content={colors.bg} />

<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed.xml" />

<!-- Link previews for when a page gets shared -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{preview && <meta property="og:image" content={preview} />}
<meta name="twitter:card" content={preview ? 'summary_large_image' : 'summary'} />

{/* Marks my own visits, so the dashboard can tell them apart. Open any page once with
    ?no-track on a device, give the password, and that browser's visits are flagged as
    mine on every page of the site. ?track takes the flag off, no password needed. The
    names are from when the switch stopped counting altogether, kept so the links I
    already use still work.

    The switch is umami.disabled in local storage, a name kept from when Umami counted the
    visits, so the browsers already switched stayed switched when it went. The tracker
    (src/scripts/tracker.ts) checks it before every send, dialogs and the CV included.
    This flips it from a link, which is the only way to do it on a phone, where there's
    no console to type into.

    The password is checked against its SHA-256 rather than written out, so it isn't
    sitting in the page source. That keeps it from casual eyes, nothing more: a single
    word can be guessed against a hash, and the switch is only a convenience anyway.

    It's inline, so it runs before the tracker, which is a deferred module. While the
    password is being asked for, the switch is already on, so the visit carrying the
    link is flagged as mine whatever the answer. A wrong answer puts the switch back the
    way it was and sends you to the homepage. */}
<script is:inline>
  (() => {
    const params = new URLSearchParams(location.search);
    const off = params.has('no-track');
    const on = params.has('track');
    if (!off && !on) return;

    let store;
    try {
      store = window.localStorage;
      store.getItem('umami.disabled');
    } catch {
      // Storage blocked, a private window for instance. There's no switch to flip.
      store = undefined;
    }

    // Out of the address bar, so the page reads as usual and the link isn't passed on
    // by accident when the URL is copied from here.
    const tidy = () => {
      params.delete('no-track');
      params.delete('track');
      const rest = params.toString();
      history.replaceState(null, '', location.pathname + (rest ? `?${rest}` : '') + location.hash);
    };

    if (on) {
      store?.removeItem('umami.disabled');
      tidy();
      if (store) alert('This browser is counted as a visitor again.');
      return;
    }

    const before = store?.getItem('umami.disabled') ?? null;
    store?.setItem('umami.disabled', 'pending');

    const answer = prompt('Password') ?? '';
    const sha256 = async (text) =>
      [...new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text)))]
        .map((byte) => byte.toString(16).padStart(2, '0'))
        .join('');

    sha256(answer).then((hash) => {
      if (store && hash === '7e70e8f070cfb15dae6dae12034f3fd276283b14eb1f0d4f964123146aa3974b') {
        store.setItem('umami.disabled', '1');
        tidy();
        alert('This browser’s visits are now marked as yours.');
        return;
      }
      if (before === null) store?.removeItem('umami.disabled');
      else store?.setItem('umami.disabled', before);
      location.replace('/');
    });
  })();
</script>
