---
import { Font } from 'astro:assets';
import { site } from '../config/site';
import { colors, colorVariables } from '../config/theme';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image for link previews. */
  image?: string;
}

const { title = site.title, description = site.description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const preview = image ? new URL(image, site.url).href : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

{/* The whole palette, straight from src/config/theme.ts. is:inline keeps Astro from
    scoping it to this component, which :root would not survive. It goes ahead of the
    stylesheets so nothing is ever painted before the colours exist. */}
<style is:inline set:html={colorVariables}></style>
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
<link rel="canonical" href={canonical} />

<Font cssVariable="--font-heading" preload />
<Font cssVariable="--font-body" preload />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content={colors.bg} />

<link rel="alternate" type="application/rss+xml" title="RSS" href="/feed.xml" />

<!-- Link previews for when a page gets shared -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{preview && <meta property="og:image" content={preview} />}
<meta name="twitter:card" content={preview ? 'summary_large_image' : 'summary'} />

{/* Pageview counter. is:inline keeps Astro's hands off it, so the data- attribute it
    looks itself up by survives. It skips anything served from localhost on its own, so
    working on the site doesn't show up in the numbers. */}
<script is:inline async data-goatcounter={site.analytics} src="https://gc.zgo.at/count.js"
></script>
