---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import Footer from '../components/Footer.astro';
import GameDialogs from '../components/GameDialogs.astro';
import AboutDialog from '../components/AboutDialog.astro';
import ScrollTop from '../components/ScrollTop.astro';
import SiteNav from '../components/SiteNav.astro';
import StructuredData from '../components/StructuredData.astro';
import banner from '../assets/banner.webp';
import { pageTitle } from '../config/site';

// Preview card for when the homepage link gets shared. 1200x630 is the size
// LinkedIn, Facebook and X all crop to.
const preview = await getImage({ src: banner, width: 1200, height: 630, format: 'jpg' });
---

<Base title={pageTitle('Portfolio')} image={preview.src}>
  <SiteNav />
  <Header />
  <PortfolioGrid />
  <Footer />
  <ScrollTop />
  <GameDialogs />
  <AboutDialog />
  <StructuredData />
</Base>
