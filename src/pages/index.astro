---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FeaturedRow from '../components/FeaturedRow.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import BeyondGames from '../components/BeyondGames.astro';
import Footer from '../components/Footer.astro';
import GameDialogs from '../components/GameDialogs.astro';
import AboutDialog from '../components/AboutDialog.astro';
import ScrollTop from '../components/ScrollTop.astro';
import SiteNav from '../components/SiteNav.astro';
import StructuredData from '../components/StructuredData.astro';
// The hero itself, captured by scripts/make-og.mjs. Rerun it when the hero changes.
import ogPreview from '../assets/og-preview.jpg';
import { pageTitle } from '../config/site';

// Preview card for when the homepage link gets shared. 1200x630 is the size
// LinkedIn, Facebook and X all crop to. It used to be banner.webp, the sky behind the
// hero, which on its own is an empty picture: the name and the footage that make it
// the hero are drawn over it by the page, not baked into it.
const preview = await getImage({ src: ogPreview, width: 1200, height: 630, format: 'jpg' });
---

<Base title={pageTitle('Portfolio')} image={preview.src}>
  <SiteNav />
  <Header>
    <FeaturedRow />
  </Header>
  <PortfolioGrid />
  {/* Hidden for now. Put it back by uncommenting this line. */}
  {/* <BeyondGames /> */}
  <Footer />
  <ScrollTop />
  <GameDialogs />
  <AboutDialog />
  <StructuredData />
</Base>
