---
// Standalone page for one game, e.g. /games/hotel-77/. Same URL the dialog puts in the
// address bar, so shared links and search engines get real HTML. Built ahead of time,
// so it works fine on GitHub Pages.
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GameDetails from '../../components/GameDetails.astro';
import Footer from '../../components/Footer.astro';
import StructuredData from '../../components/StructuredData.astro';
import { site, pageTitle, plainText } from '../../config/site';
import { sortTags, tagsIn, yearRange } from '../../config/tags';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;

const title = plainText(game.data.title);
const description = plainText(game.data.description ?? site.description).slice(0, 200);

// Give link previews the game's own art rather than nothing.
const preview = await getImage({ src: game.data.img, width: 1200, format: 'jpg' });

// Search engines get the same facts the page shows, straight from the tags.
const dates = yearRange(game.data.startDate, game.data.endDate);
const [publisher] = tagsIn(game.data.tags, 'client');
const keywords = sortTags(game.data.tags).map((tag) => tag.label);

const work = {
  '@type': 'CreativeWork',
  name: title,
  description,
  url: new URL(`/games/${game.id}/`, site.url).href,
  image: new URL(preview.src, site.url).href,
  author: { '@id': `${site.url}/#person` },
  ...(dates && { dateCreated: dates }),
  ...(publisher && { publisher: { '@type': 'Organization', name: publisher.label } }),
  ...(keywords.length > 0 && { keywords: keywords.join(', ') }),
};
---

<Base title={pageTitle(title)} description={description} image={preview.src}>
  <nav class="crumb container">
    <a href="/#portfolio">&larr; {site.title}</a>
  </nav>

  <main class="container">
    <article>
      <GameDetails game={game}>
        <a slot="action" class="btn" href="/#portfolio">Back to Portfolio</a>
      </GameDetails>
    </article>
  </main>

  <Footer />
  <StructuredData extra={work} />
</Base>

<style>
  .crumb {
    padding-top: 20px;
  }

  .crumb a {
    opacity: 0.7;
    color: var(--color-txt);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity var(--transition);
  }

  .crumb a:hover,
  .crumb a:focus-visible {
    opacity: 1;
  }

  main {
    padding: 30px 0 60px;
  }

  article {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    border: 2px groove var(--color-txt);
    border-radius: 25px;
    text-align: center;
  }
</style>
