---
// Standalone page for one game, e.g. /games/hotel-77/. Same URL the dialog puts in the
// address bar, so shared links and search engines get real HTML. Built ahead of time,
// so it works fine on GitHub Pages.
import { getCollection, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import GameDetails from '../../components/GameDetails.astro';
import Footer from '../../components/Footer.astro';
import StructuredData from '../../components/StructuredData.astro';
import { site, pageTitle, plainText } from '../../config/site';
import { sortTags, tagsIn, yearRange } from '../../config/tags';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

interface Props {
  game: CollectionEntry<'games'>;
}

const { game } = Astro.props;

const title = plainText(game.data.title);
const description = plainText(game.data.description ?? site.description).slice(0, 200);

// Give link previews the game's own art rather than nothing.
const preview = await getImage({ src: game.data.img, width: 1200, format: 'jpg' });

// Search engines get the same facts the page shows, straight from the tags.
const dates = yearRange(game.data.startDate, game.data.endDate);
const [publisher] = tagsIn(game.data.tags, 'client');
const keywords = sortTags(game.data.tags).map((tag) => tag.label);

const work = {
  '@type': 'CreativeWork',
  name: title,
  description,
  url: new URL(`/games/${game.id}/`, site.url).href,
  image: new URL(preview.src, site.url).href,
  author: { '@id': `${site.url}/#person` },
  ...(dates && { dateCreated: dates }),
  ...(publisher && { publisher: { '@type': 'Organization', name: publisher.label } }),
  ...(keywords.length > 0 && { keywords: keywords.join(', ') }),
};
---

<Base title={pageTitle(title)} description={description} image={preview.src}>
  <main class="container">
    {/* Inside main rather than above it, so it shares the article's centring and lands
        on the same left edge at every breakpoint — the container steps 750/970/1170
        while the article stays 900, so the offset between them is not a fixed number. */}
    <nav class="crumb">
      <a href="/#portfolio">
        <Icon name="angle-left" class="crumb-icon" />
        Portfolio
      </a>
    </nav>

    <article>
      <GameDetails game={game}>
        <a slot="action" class="btn" href="/#portfolio">Back to Portfolio</a>
      </GameDetails>
    </article>
  </main>

  <Footer />
  <StructuredData extra={work} />
</Base>

<style>
  /* The article's own box, so the chevron starts exactly on its border rather than
     out in the margin beside it. */
  .crumb {
    max-width: 900px;
    margin: 0 auto 20px;
  }

  .crumb a {
    /* inline-flex so the chevron and the word sit on one baseline and the link is only
       as wide as the two of them — a block would hand the scale the whole column. */
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    opacity: 0.7;
    color: var(--color-txt);
    font-family: var(--font-heading), sans-serif;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    text-transform: uppercase;
    /* Grows rightward from that border, not outward from its own middle: a centred
       scale would push the chevron back out past the edge it was just aligned to. */
    transform-origin: left center;
    transition: opacity var(--transition), transform 0.6s ease;
  }

  .crumb a:hover,
  .crumb a:focus-visible {
    opacity: 1;
    transform: scale(1.15);
  }

  /* Under 1 so the press compresses past rest and springs back, the way the tabs do. */
  .crumb a:active {
    transform: scale(0.85);
    transition-duration: 0.08s;
  }

  /* :global because the <svg> comes from Icon.astro and carries that component's scope
     rather than this page's. */
  .crumb a :global(.crumb-icon) {
    width: auto;
    height: 0.9em;
    fill: currentColor;
  }

  main {
    padding: 30px 0 60px;
  }

  article {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    border: 2px groove var(--color-txt);
    border-radius: 25px;
    text-align: center;
  }
</style>
