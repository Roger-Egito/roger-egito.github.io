---
/**
 * The analytics report: drop an Umami Cloud export on it and it shows who visited, what
 * each person did, and every way of slicing it.
 *
 * Kept out of the way, not locked (GitHub Pages can't do passwords): noindex, out of the
 * sitemap and the nav, and no tracker. That's enough because the page holds no data.
 * The export is read in the browser, in page.ts, and nothing is sent anywhere.
 *
 * A dynamic route with one path, so the URL is written in one place:
 * src/config/private.ts, which the sitemap filter reads too.
 */
import Base from '../layouts/Base.astro';
import { reportSlug } from '../config/private';
import { reportConfig } from '../lib/umami-report/config';

export function getStaticPaths() {
  return [{ params: { report: reportSlug } }];
}
---

<Base title="Analytics" track={false} noindex>
  <main class="report">
    <header class="report-head">
      <h1>Analytics</h1>
      <p class="note">
        Times in {reportConfig.timeZone}. Exports are read in this browser and never leave it.
      </p>
    </header>

    <label class="drop" data-report-load>
      <input type="file" multiple accept=".gz,.tgz,.tar,.zip,.csv" data-report-files />
      <span>
        Choose the Umami Cloud export, or drop it here: the .gz as it downloads, or
        website_event.csv with event_data.csv.
      </span>
    </label>
    <p class="status" data-report-status aria-live="polite"></p>

    <div data-report-summary></div>

    {/* Stays on screen while scrolling, so the filters are always one click away. The
        search box is outside the part that's redrawn, so typing never loses focus. */}
    <div class="filter-bar" data-report-bar hidden>
      <div class="bar-row">
        <div class="bar-main" data-report-bar-main></div>
        <label class="search-box">
          <span class="visually-hidden">Search</span>
          <input type="search" placeholder="Search places, pages, referrers…" data-report-search />
        </label>
      </div>
      <div class="chips" data-report-chips></div>
    </div>

    <div class="output" data-report-output></div>

    <dialog class="profile" data-report-profile aria-label="Visitor"></dialog>
  </main>
</Base>

<script>
  import '../scripts/umami-report/page';
</script>

{/* Global, but every rule sits under .report (or the tooltip's own class): almost all
    of these elements are made by the page script at runtime and carry no scope
    attribute, so scoped rules would miss them. */}
<style is:global>
  /* Chart colours: the first three slots of the dataviz skill's categorical palette, in
     their dark-mode steps, checked with its validator against this page's card colour
     (#1d1d1d): all pairs pass for colour-blind readers and all clear 3:1. Real visitors
     take slot one, since they're what the page is about. */
  .report,
  .report-tip {
    --kind-real: #3987e5;
    --kind-me: #d95926;
    --kind-bot: #199e70;
    --ink: #f0efec;
    --ink-2: #c3c2b7;
    --ink-3: #898781;
    --grid: #2c2c2a;
    --axis: #383835;
    --card: var(--color-raised);
    --line: rgba(255, 255, 255, 0.1);
  }

  .report {
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px 16px 80px;
    color: var(--ink-2);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 14px;
  }

  .report h1,
  .report h2,
  .report h3 {
    color: var(--ink);
    font-family: inherit;
    text-transform: none;
  }

  .report h1 {
    margin: 0;
    font-size: 28px;
  }

  .report h2 {
    margin: 0;
    font-size: 16px;
  }

  .report p {
    font-size: inherit;
  }

  .report .note,
  .report .status {
    margin: 6px 0 0;
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .report .empty {
    margin: 8px 0;
    color: var(--ink-3);
    font-style: italic;
  }

  .report .report-head {
    margin-bottom: 18px;
  }

  .report .drop {
    display: grid;
    place-items: center;
    gap: 10px;
    padding: 32px 20px;
    border: 2px dashed var(--line);
    border-radius: 8px;
    text-align: center;
    cursor: var(--cursor-pointer);
  }

  .report .drop[hidden] {
    display: none;
  }

  .report .drop[data-over] {
    border-color: var(--ink-2);
  }

  /* --- buttons ------------------------------------------------------------------ */

  .report button {
    font: inherit;
    cursor: var(--cursor-default);
  }

  .report .quiet,
  .report .more,
  .report .segmented button,
  .report .type-toggle,
  .report .chip,
  .report select,
  .report input[type='date'],
  .report input[type='search'] {
    min-height: 30px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card);
    color: var(--ink-2);
    font: inherit;
    font-size: 13px;
  }

  .report .quiet:hover:not(:disabled),
  .report .more:hover,
  .report .segmented button:hover,
  .report .chip:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  .report .quiet:disabled {
    opacity: 0.4;
  }

  .report .quiet[hidden] {
    display: none;
  }

  .report .more {
    margin-top: 8px;
  }

  .report .link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--ink-3);
    text-underline-offset: 3px;
  }

  .report .link:hover {
    text-decoration-color: var(--ink);
  }

  .report .segmented {
    display: inline-flex;
  }

  .report .segmented button {
    border-radius: 0;
  }

  .report .segmented button:first-child {
    border-radius: 6px 0 0 6px;
  }

  .report .segmented button:last-child {
    border-radius: 0 6px 6px 0;
  }

  .report .segmented button + button {
    border-left: 0;
  }

  .report .segmented button[aria-pressed='true'] {
    background: var(--ink);
    color: var(--color-bg);
    font-weight: 600;
  }

  /* --- keys ---------------------------------------------------------------------- */

  .report .key,
  .report-tip .key {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }

  .report .key-box {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 2px;
  }

  .report-tip .key-line,
  .report-tip .key-none {
    width: 12px;
    height: 2px;
    border-radius: 1px;
  }

  .report .kind-real,
  .report-tip .kind-real {
    background: var(--kind-real);
    fill: var(--kind-real);
  }

  .report .kind-me,
  .report-tip .kind-me {
    background: var(--kind-me);
    fill: var(--kind-me);
  }

  .report .kind-bot,
  .report-tip .kind-bot {
    background: var(--kind-bot);
    fill: var(--kind-bot);
  }

  .report .kind-tag {
    white-space: nowrap;
  }

  /* --- whole export -------------------------------------------------------------- */

  .report .whole {
    display: grid;
    gap: 10px;
    margin-bottom: 14px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .report .whole-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }

  .report .whole-head .note {
    margin: 0;
  }

  .report .figures {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
  }

  .report .figure strong {
    display: block;
    color: var(--ink);
    font-size: 20px;
  }

  .report .figure span {
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* --- filter bar ---------------------------------------------------------------- */

  .report .filter-bar {
    position: sticky;
    z-index: 5;
    top: 0;
    margin: 0 -16px 16px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: var(--color-bg);
  }

  .report .filter-bar[hidden] {
    display: none;
  }

  .report .bar-row,
  .report .bar-main,
  .report .bar-group,
  .report .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .report .bar-row {
    justify-content: space-between;
    gap: 10px 24px;
  }

  .report .bar-main {
    gap: 10px 24px;
  }

  .report .dash {
    color: var(--ink-3);
  }

  .report .type-toggle {
    display: inline-flex;
    align-items: center;
  }

  .report .type-toggle .count {
    margin-left: 6px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .report .type-toggle.off {
    opacity: 0.45;
  }

  .report .search-box input {
    width: 260px;
    max-width: 100%;
  }

  .report .chips:not(:empty) {
    margin-top: 8px;
  }

  .report .chip {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  /* --- cards and tiles ----------------------------------------------------------- */

  .report .output {
    display: grid;
    gap: 16px;
  }

  .report .card {
    min-width: 0;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
  }

  .report .card-head,
  .report .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 12px;
  }

  .report .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .report .pair {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 1000px) {
    .report .pair {
      grid-template-columns: 1fr 1fr;
    }
  }

  .report .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
  }

  .report .tile {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
  }

  .report .tile-label {
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .report .tile strong {
    color: var(--ink);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.1;
  }

  .report .split {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .split .key-box {
    width: 8px;
    height: 8px;
    margin-right: 4px;
  }

  /* --- charts -------------------------------------------------------------------- */

  .report .chart {
    display: block;
    width: 100%;
    height: auto;
  }

  .report .chart .grid {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .report .chart .baseline {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .report .chart .tick {
    fill: var(--ink-3);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .report .chart .hit {
    fill: transparent;
    outline: none;
  }

  .report .chart .column:hover .hit,
  .report .chart .hit:focus-visible {
    fill: rgba(255, 255, 255, 0.04);
  }

  .report .chart .column.selected .hit {
    fill: rgba(255, 255, 255, 0.09);
  }

  .report .chart .column:hover .fill {
    filter: brightness(1.15);
  }

  .report .chart .fill {
    pointer-events: none;
  }

  .report .heatmap .cell {
    outline: none;
  }

  /* Only the empty cells: a class rule on every cell would beat the fill attribute
     the script gives each one, and paint them all the same. */
  .report .heatmap .cell.zero {
    fill: #262624;
  }

  .report .heatmap .cell:hover,
  .report .heatmap .cell:focus-visible,
  .report .heatmap .cell.selected {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .report .heatmap .axis-button {
    cursor: var(--cursor-default);
    outline: none;
  }

  .report .heatmap .axis-button:hover,
  .report .heatmap .axis-button:focus-visible,
  .report .heatmap .axis-button.on {
    fill: var(--ink);
    font-weight: 700;
  }

  .report .heat-scale {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-top: 8px;
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .heat-step {
    width: 14px;
    height: 10px;
    border-radius: 2px;
    background: #262624;
  }

  .report .heat-scale span:first-child {
    margin-right: 4px;
  }

  .report .heat-scale span:last-child {
    margin-left: 4px;
  }

  .report .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    margin-top: 8px;
    font-size: 13px;
  }

  .report .legend-item {
    display: inline-flex;
    align-items: center;
    padding: 2px 0;
    border: 0;
    background: none;
    color: var(--ink-2);
  }

  .report .legend-item.off {
    opacity: 0.4;
    text-decoration: line-through;
  }

  .report .table-view {
    margin-top: 10px;
  }

  .report .table-view summary {
    color: var(--ink-3);
    font-size: 12.5px;
    cursor: var(--cursor-default);
  }

  /* --- breakdowns ---------------------------------------------------------------- */

  .report .breakdowns .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 16px;
    margin-top: 12px;
  }

  .report .breakdowns .card-head {
    margin-bottom: 6px;
  }

  .report .bar-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .report .bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 3px 10px;
    width: 100%;
    padding: 6px 8px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--ink-2);
    text-align: left;
  }

  .report .bar-row:hover,
  .report .bar-row:focus-visible {
    background: rgba(255, 255, 255, 0.05);
  }

  .report .bar-row.selected {
    background: rgba(255, 255, 255, 0.09);
    color: var(--ink);
  }

  .report .bar-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .report .check {
    margin-right: 6px;
    font-weight: 700;
  }

  .report .bar-amount {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .report .bar-track {
    grid-column: 1 / -1;
    height: 6px;
  }

  .report .bar-fill {
    display: flex;
    gap: 2px;
    min-width: 2px;
    height: 100%;
  }

  .report .bar-part {
    flex-basis: 0;
    min-width: 2px;
    height: 100%;
  }

  .report .bar-part:last-child {
    border-radius: 0 3px 3px 0;
  }

  /* --- tables -------------------------------------------------------------------- */

  .report .table-wrap {
    overflow-x: auto;
  }

  .report table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .report th,
  .report td {
    padding: 7px 8px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .report th {
    color: var(--ink-3);
    font-weight: 400;
    white-space: nowrap;
  }

  .report .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .report .sort {
    display: inline-flex;
    gap: 4px;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
  }

  .report .sort:hover {
    color: var(--ink);
  }

  .report th[aria-sort='ascending'],
  .report th[aria-sort='descending'] {
    color: var(--ink);
  }

  .report .arrow {
    font-size: 10px;
    opacity: 0.7;
  }

  .report tr.clickable {
    cursor: var(--cursor-pointer);
  }

  .report tr.clickable:hover td {
    background: rgba(255, 255, 255, 0.04);
  }

  .report tr.open td {
    background: rgba(255, 255, 255, 0.06);
  }

  .report tr.changed td:first-child {
    box-shadow: inset 3px 0 0 var(--ink);
  }

  .report tr.detail td {
    padding: 4px 8px 14px 28px;
    background: rgba(255, 255, 255, 0.03);
  }

  .report .reason {
    color: var(--ink-3);
  }

  .report .disclosure {
    color: var(--ink-3);
  }

  .report .kind-select {
    min-height: 26px;
    padding: 2px 6px;
    border-left: 4px solid var(--line);
  }

  .report .kind-select.kind-real {
    border-left-color: var(--kind-real);
    background: var(--card);
  }

  .report .kind-select.kind-me {
    border-left-color: var(--kind-me);
    background: var(--card);
  }

  .report .kind-select.kind-bot {
    border-left-color: var(--kind-bot);
    background: var(--card);
  }

  /* --- a visit's pages ----------------------------------------------------------- */

  .report .steps {
    display: grid;
    gap: 4px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
  }

  .report .steps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
  }

  .report .step-time {
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .report .step-stay {
    color: var(--ink-3);
  }

  .report .step-event {
    padding: 1px 8px;
    border: 1px solid var(--line);
    border-radius: 100px;
    color: var(--ink);
    font-size: 12px;
  }

  /* --- one person ---------------------------------------------------------------- */

  .report .profile {
    width: min(900px, 94vw);
    max-width: none;
    max-height: 90vh;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--color-bg);
    color: var(--ink-2);
  }

  .report .profile::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .report .profile-sheet {
    display: flex;
    flex-direction: column;
    max-height: 90vh;
  }

  .report .profile-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px 20px;
    padding: 18px 20px 14px;
    border-bottom: 1px solid var(--line);
  }

  .report .profile-head h2 {
    font-size: 19px;
  }

  .report .profile-head .reason {
    margin: 4px 0 0;
    font-size: 12.5px;
  }

  .report .profile-nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .report .profile-body {
    padding: 16px 20px 22px;
    overflow-y: auto;
  }

  .report .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px 20px;
    margin: 0 0 18px;
  }

  .report .fact dt {
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .fact dd {
    margin: 2px 0 0;
    color: var(--ink);
  }

  .report .profile-sub {
    margin: 20px 0 8px;
    font-size: 15px;
  }

  .report .profile-visit {
    margin-top: 14px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
  }

  .report .profile-visit h3 {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 12px;
    margin: 0;
    font-size: 14px;
  }

  .report .visit-meta {
    color: var(--ink-3);
    font-weight: 400;
  }

  .report .profile .actions {
    margin-top: 18px;
  }

  /* --- the tooltip --------------------------------------------------------------- */

  .report-tip {
    position: fixed;
    z-index: 50;
    display: grid;
    gap: 3px;
    min-width: 140px;
    max-width: 320px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #262624;
    color: var(--ink-2);
    font: 12.5px system-ui, -apple-system, 'Segoe UI', sans-serif;
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.4);
    pointer-events: none;
  }

  .report-tip[hidden] {
    display: none;
  }

  .report-tip .tip-title {
    margin-bottom: 2px;
    color: var(--ink-2);
    font-weight: 400;
  }

  .report-tip .tip-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .report-tip .tip-row b {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
</style>
