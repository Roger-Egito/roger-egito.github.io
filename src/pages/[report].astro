---
/**
 * The analytics report: reads the site's own collector and shows who visited, what each
 * person did, and every way of slicing it.
 *
 * Kept out of the way, not locked (GitHub Pages can't do passwords): noindex, out of the
 * sitemap and the nav, and no tracker. That's enough because the page holds no data.
 * The data comes from the collector, and only with the read key from a browser approved
 * by email (collector/src/index.ts).
 *
 * A dynamic route with one path, so the URL is written in one place:
 * src/config/private.ts, which the sitemap filter reads too.
 */
import Base from '../layouts/Base.astro';
import { reportSlug } from '../config/private';
import { reportConfig } from '../lib/umami-report/config';

export function getStaticPaths() {
  return [{ params: { report: reportSlug } }];
}
---

<Base title="Analytics" track={false} noindex>
  <div class="report">
    {/* The site's own collector, read with its key. page.ts keeps the key in this
        browser once it works, and reads the collector on every visit after. Hidden
        until page.ts knows it's needed, so a kept key never flashes the form. */}
    <form class="connect" data-report-connect hidden>
      <strong>Connect to the collector</strong>
      <label>
        <span class="muted small">Collector address</span>
        <input name="collector" type="url" placeholder="https://portfolio-data….workers.dev" required />
      </label>
      <label>
        <span class="muted small">Read key</span>
        <input name="key" type="password" autocomplete="off" required />
      </label>
      <button type="submit" class="button primary">Connect</button>
    </form>
    <p class="status" data-report-status aria-live="polite"></p>

    <div class="app" data-report-app hidden>
      {/* Stays at the top while scrolling. The search box sits outside the part that's
          redrawn, so typing never loses focus. */}
      <header class="topbar">
        <div class="topbar-row">
          <div class="brand">
            <span class="brand-mark" aria-hidden="true"></span>
            <span>Analytics</span>
            <span class="muted small">roger-egito.github.io · {reportConfig.timeZone}</span>
          </div>
          <div class="controls" data-report-controls></div>
        </div>
        <div class="topbar-row">
          <nav class="tabs" role="tablist" aria-label="Views" data-report-tabs></nav>
          <label class="search">
            <span class="visually-hidden">Search</span>
            <input type="search" placeholder="Search places, pages, referrers…  /" data-report-search />
          </label>
        </div>
        <div class="chips" data-report-chips hidden></div>
      </header>

      <main class="main" data-report-main></main>
    </div>
  </div>
</Base>

<script>
  import '../scripts/umami-report/page';
</script>

{/* Global, but every rule sits under .report (or the tooltip's own class): almost all
    of these elements are made by the page script at runtime and carry no scope
    attribute, so scoped rules would miss them. */}
<style is:global>
  /* Chart colors: the first three slots of the dataviz skill's categorical palette, in
     their dark-mode steps, checked with its validator against the card color: all pairs
     pass for color-blind readers and all clear 3:1. Real visitors take slot one, since
     they're what the page is about. */
  .report,
  .report-tip {
    --kind-real: #3987e5;
    --kind-me: #d95926;
    --kind-bot: #199e70;
    --page: #111110;
    --card: #191918;
    --raised: #222220;
    --hover: rgba(255, 255, 255, 0.045);
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.14);
    --ink: #f0efec;
    --ink-2: #c3c2b7;
    --ink-3: #8b8a84;
    --grid: #2a2a28;
    --axis: #383835;
    --radius: 10px;
  }

  body:has(.report) {
    background: var(--page, #111110);
  }

  .report {
    min-height: 100vh;
    background: var(--page);
    color: var(--ink-2);
    font: 14px/1.45 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .report h1,
  .report h2,
  .report h3 {
    margin: 0;
    color: var(--ink);
    font-family: inherit;
    font-weight: 600;
    text-transform: none;
  }

  .report p {
    font-size: inherit;
  }

  .report .muted {
    color: var(--ink-3);
  }

  .report .small {
    font-size: 12.5px;
  }

  .report .note {
    margin: 10px 0 0;
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .report .empty {
    margin: 12px 0;
    color: var(--ink-3);
  }

  .report button,
  .report select,
  .report input {
    font: inherit;
  }

  .report button {
    cursor: var(--cursor-default);
  }

  /* --- first screen: connecting to the collector -------------------------------- */

  .report .connect[hidden] {
    display: none;
  }

  .report .connect {
    display: grid;
    gap: 10px;
    max-width: 640px;
    margin: 12vh auto 0;
    padding: 22px 28px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
  }

  .report .connect strong {
    color: var(--ink);
  }

  .report .connect label {
    display: grid;
    gap: 4px;
  }

  .report .connect input {
    height: 34px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--page);
    color: var(--ink);
  }

  .report .connect button {
    justify-self: start;
  }

  .report .status {
    margin: 12px auto 0;
    max-width: 640px;
    color: var(--ink-3);
    text-align: center;
  }

  .report .status:empty {
    display: none;
  }

  /* --- the top bar ---------------------------------------------------------------- */

  .report .app {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px 80px;
  }

  .report .app[hidden] {
    display: none;
  }

  .report .topbar {
    position: sticky;
    z-index: 10;
    top: 0;
    margin: 0 -20px 20px;
    padding: 12px 20px 0;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--page) 92%, transparent);
    backdrop-filter: blur(10px);
  }

  .report .topbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
  }

  .report .topbar-row + .topbar-row {
    margin-top: 10px;
  }

  .report .brand {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--ink);
    font-size: 17px;
    font-weight: 650;
  }

  .report .brand-mark {
    align-self: center;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: linear-gradient(135deg, var(--kind-real), color-mix(in srgb, var(--kind-real) 40%, var(--kind-bot)));
  }

  .report .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .report .types {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--card);
  }

  .report .type {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 5px 10px;
    border: 0;
    border-radius: 6px;
    background: var(--raised);
    color: var(--ink);
    font-size: 13px;
  }

  .report .type + .type {
    margin-left: 3px;
  }

  .report .type.off {
    background: transparent;
    color: var(--ink-3);
  }

  .report .type.off .key {
    opacity: 0.4;
  }

  .report .type .count {
    margin-left: 6px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .report .search input {
    width: 300px;
    max-width: 100%;
    height: 34px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--ink);
  }

  .report .search input:focus {
    border-color: var(--kind-real);
    outline: none;
  }

  .report .tabs {
    display: flex;
    gap: 4px;
  }

  .report .tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 12px 11px;
    border: 0;
    background: none;
    color: var(--ink-3);
    font-size: 14px;
    font-weight: 550;
  }

  .report .tab:hover {
    color: var(--ink);
  }

  .report .tab[aria-selected='true'] {
    color: var(--ink);
  }

  .report .tab[aria-selected='true']::after {
    position: absolute;
    right: 10px;
    bottom: -1px;
    left: 10px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    content: '';
  }

  .report .tab-count {
    padding: 0 6px;
    border-radius: 100px;
    background: var(--raised);
    color: var(--ink-3);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
  }

  .report .chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 10px 0 12px;
  }

  .report .chips[hidden] {
    display: none;
  }

  .report .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 6px 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: 100px;
    background: var(--raised);
    color: var(--ink);
    font-size: 12.5px;
  }

  .report .chip:hover {
    border-color: var(--ink-3);
  }

  .report .chip-x {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--hover);
    color: var(--ink-3);
    font-size: 9px;
  }

  /* --- menus ---------------------------------------------------------------------- */

  .report .menu {
    position: relative;
  }

  .report .menu > summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--ink);
    font-size: 13px;
    list-style: none;
    cursor: var(--cursor-default);
  }

  .report .menu > summary::-webkit-details-marker {
    display: none;
  }

  .report .menu > summary > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .report .caret {
    color: var(--ink-3);
    font-size: 10px;
  }

  .report .menu > summary:hover,
  .report .menu[open] > summary {
    border-color: var(--line-strong);
    background: var(--raised);
  }

  .report .menu-panel {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    gap: 2px;
    min-width: 240px;
    max-height: 70vh;
    padding: 6px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--raised);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.45);
    overflow-y: auto;
  }

  .report .filter-menu .menu-panel {
    width: 320px;
  }

  .report .data-menu .menu-panel {
    width: 380px;
    padding: 14px;
    gap: 10px;
  }

  .report .menu-title {
    margin: 4px 6px;
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .report .menu-row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 7px 8px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--ink-2);
    text-align: left;
  }

  .report .menu-row:hover,
  .report .menu-row:focus-visible {
    background: var(--hover);
    color: var(--ink);
  }

  .report .menu-row[aria-pressed='true'] {
    color: var(--ink);
  }

  .report .menu-check {
    flex: none;
    width: 16px;
    color: var(--ink);
    font-weight: 700;
  }

  .report .menu-value {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .report .menu-back {
    padding: 6px 8px;
    border: 0;
    background: none;
    color: var(--ink);
    font-weight: 600;
    text-align: left;
  }

  .report .menu-panel input[type='search'],
  .report .menu-panel input[type='date'] {
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--line-strong);
    border-radius: 6px;
    background: var(--card);
    color: var(--ink);
    color-scheme: dark;
  }

  .report .menu-values {
    display: grid;
    gap: 2px;
    margin-top: 4px;
  }

  .report .menu-rule {
    height: 1px;
    margin: 6px 0;
    background: var(--line);
  }

  .report .menu-custom {
    display: grid;
    gap: 8px;
    padding: 4px 6px;
  }

  .report .menu-dates {
    display: flex;
    gap: 6px;
  }

  .report .menu-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .report .badge {
    padding: 0 6px;
    border-radius: 100px;
    background: var(--kind-real);
    color: #fff;
    font-size: 11px;
    font-weight: 600;
  }

  .report .figures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .report .figure strong {
    display: block;
    color: var(--ink);
    font-size: 18px;
  }

  .report .figure span {
    color: var(--ink-3);
    font-size: 12px;
  }

  /* --- buttons, links, segmented --------------------------------------------------- */

  .report .button,
  .report .more {
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--raised);
    color: var(--ink);
    font-size: 13px;
  }

  .report .button:hover:not(:disabled),
  .report .more:hover {
    border-color: var(--ink-3);
  }

  .report .button:disabled {
    opacity: 0.4;
  }

  .report .button.primary {
    border-color: var(--kind-real);
    background: var(--kind-real);
    color: #fff;
  }

  .report .more {
    margin-top: 10px;
  }

  .report .link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: left;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }

  .report .link:hover {
    text-decoration-color: var(--ink-2);
  }

  .report .segmented {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--page);
  }

  .report .segmented button {
    padding: 3px 9px;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--ink-3);
    font-size: 12.5px;
  }

  .report .segmented button:hover {
    color: var(--ink);
  }

  .report .segmented button[aria-pressed='true'] {
    background: var(--raised);
    color: var(--ink);
  }

  /* --- keys ------------------------------------------------------------------------ */

  .report .key,
  .report-tip .key {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }

  .report .key-box {
    width: 9px;
    height: 9px;
    margin-right: 6px;
    border-radius: 2.5px;
  }

  .report-tip .key-line,
  .report-tip .key-none {
    width: 12px;
    height: 2px;
    border-radius: 1px;
  }

  .report .kind-real,
  .report-tip .kind-real {
    background: var(--kind-real);
    fill: var(--kind-real);
  }

  .report .kind-me,
  .report-tip .kind-me {
    background: var(--kind-me);
    fill: var(--kind-me);
  }

  .report .kind-bot,
  .report-tip .kind-bot {
    background: var(--kind-bot);
    fill: var(--kind-bot);
  }

  .report .kind-tag {
    white-space: nowrap;
  }

  /* --- cards ----------------------------------------------------------------------- */

  .report .main {
    display: grid;
    gap: 16px;
  }

  .report .card {
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--card);
  }

  .report .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 12px;
  }

  .report .card-head h2 {
    font-size: 14.5px;
  }

  .report .card-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
  }

  .report .card-tabs button {
    position: relative;
    padding: 2px 0 6px;
    border: 0;
    background: none;
    color: var(--ink-3);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .report .card-tabs button:hover {
    color: var(--ink-2);
  }

  .report .card-tabs button[aria-selected='true'] {
    color: var(--ink);
  }

  .report .card-tabs button[aria-selected='true']::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    content: '';
  }

  .report .cards {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 960px) {
    .report .cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* --- the overview's numbers and chart -------------------------------------------- */

  .report .hero {
    padding: 0;
    overflow: hidden;
  }

  .report .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    border-bottom: 1px solid var(--line);
  }

  .report .stat {
    display: grid;
    align-content: start;
    gap: 3px;
    padding: 16px 18px;
    border: 0;
    border-right: 1px solid var(--line);
    background: none;
    color: inherit;
    text-align: left;
  }

  .report .stat:last-child {
    border-right: 0;
  }

  .report button.stat:hover {
    background: var(--hover);
  }

  .report .stat[aria-pressed='true'] {
    background: var(--raised);
    box-shadow: inset 0 -2px 0 var(--ink);
  }

  .report .stat-label {
    color: var(--ink-3);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .report .stat-value {
    color: var(--ink);
    font-size: 26px;
    font-weight: 650;
    line-height: 1.15;
  }

  .report .stat-sub {
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .split {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .split .key-box {
    width: 7px;
    height: 7px;
    margin-right: 4px;
  }

  .report .hero .chart-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 14px 18px 0;
  }

  .report .hero .chart,
  .report .hero .empty {
    margin: 4px 10px 0;
  }

  .report .hero .note {
    margin: 0;
    padding: 4px 18px 16px;
  }

  /* --- charts ---------------------------------------------------------------------- */

  .report .chart {
    display: block;
    width: 100%;
    height: auto;
  }

  .report .chart .grid {
    stroke: var(--grid);
    stroke-width: 1;
  }

  .report .chart .baseline {
    stroke: var(--axis);
    stroke-width: 1;
  }

  .report .chart .tick {
    fill: var(--ink-3);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .report .chart .hit {
    fill: transparent;
    outline: none;
  }

  .report .chart .column:hover .hit,
  .report .chart .hit:focus-visible {
    fill: rgba(255, 255, 255, 0.04);
  }

  .report .chart .column.selected .hit {
    fill: rgba(255, 255, 255, 0.08);
  }

  .report .chart .column:hover .fill {
    filter: brightness(1.15);
  }

  .report .chart .fill {
    pointer-events: none;
  }

  .report .heatmap .cell {
    outline: none;
  }

  /* Only the empty cells: a class rule on every cell would beat the fill attribute the
     script gives each one, and paint them all the same. */
  .report .heatmap .cell.zero {
    fill: #232321;
  }

  .report .heatmap .cell:hover,
  .report .heatmap .cell:focus-visible,
  .report .heatmap .cell.selected {
    stroke: var(--ink);
    stroke-width: 2;
  }

  .report .heatmap .axis-button {
    cursor: var(--cursor-default);
    outline: none;
  }

  .report .heatmap .axis-button:hover,
  .report .heatmap .axis-button:focus-visible,
  .report .heatmap .axis-button.on {
    fill: var(--ink);
    font-weight: 700;
  }

  .report .heat-scale {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-top: 10px;
    color: var(--ink-3);
    font-size: 12px;
  }

  .report .heat-step {
    width: 14px;
    height: 10px;
    border-radius: 2px;
    background: #232321;
  }

  .report .heat-scale span:first-child {
    margin-right: 4px;
  }

  .report .heat-scale span:last-child {
    margin-left: 4px;
  }

  .report .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 12.5px;
  }

  .report .legend-item {
    display: inline-flex;
    align-items: center;
    color: var(--ink-2);
  }

  /* --- ranked lists ---------------------------------------------------------------- */

  .report .rank-head {
    display: flex;
    justify-content: space-between;
    padding: 0 8px 6px;
    color: var(--ink-3);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .report .rank-list {
    display: grid;
    gap: 3px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .report .rank-row {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
