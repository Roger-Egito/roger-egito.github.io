---
// What GitHub Pages serves, with a real 404 status, for any address that has no page:
// a mistyped link, or an old URL from the Jekyll site. Without it the visitor gets
// GitHub's own 404, which has no way back here. The sitemap leaves 404 pages out on its
// own, so nothing points search engines at it.
import Base from '../layouts/Base.astro';
import Crumb from '../components/Crumb.astro';
import StarRule from '../components/StarRule.astro';
import Footer from '../components/Footer.astro';
import { pageTitle } from '../config/site';
---

<Base title={pageTitle('Page not found')} noindex>
  <main class="container">
    <Crumb />

    <article class="panel">
      <h1 class="section-heading">Page not found</h1>
      <StarRule />
      <p>
        There's nothing at this address. The page may have moved, or the link may have a
        typo. Every game is on the <a href="/#portfolio">portfolio</a>, and there's more
        about me on the <a href="/about/">About</a> page.
      </p>
      <a class="btn" href="/#portfolio">Back to Portfolio</a>
    </article>
  </main>

  <Footer />
</Base>

<style>
  main {
    padding: 30px 0 60px;
  }

  /* Same card border as the About page and the game pages. */
  article {
    border: 2px groove var(--color-txt);
    border-radius: 25px;
  }

  p {
    margin: 0 0 var(--space-gap);
  }
</style>
