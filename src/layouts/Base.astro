---
import '../styles/tokens.css';
import '../styles/global.css';
import Head from '../components/Head.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** false leaves the analytics off the page entirely, for pages that aren't the site. */
  track?: boolean;
  /** Asks search engines to leave the page out of their results. */
  noindex?: boolean;
}

const { title, description, image, track = true, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    {/*
      No <ClientRouter />. View transitions took over the Back button, and cancelling
      one only downgrades it to a full page reload rather than stopping it — which
      wiped out the dialog before "Close the game?" could be answered, taking the
      running build with it. The animation wasn't worth 16 KB or that behaviour.
    */}
    <Head title={title} description={description} image={image} track={track} noindex={noindex} />
  </head>

  <body id="page-top">
    <slot />

    {/* After the slot, so it's the last dialog on the page and opens over a game's. */}
    <Lightbox />

    {/* Here rather than in a component so it's on every page, the game pages included:
        it counts the About dialog and the CV, which the tracker can't see itself. */}
    {
      track && (
        <script>
          import '../scripts/analytics';
        </script>
      )
    }
  </body>
</html>
