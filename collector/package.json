{
  "name": "portfolio-collector",
  "private": true,
  "type": "module",
  "description": "The site's own analytics collector: a Cloudflare Worker that stores visits in D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "schema:local": "wrangler d1 execute portfolio-events --local --file schema.sql",
    "schema:remote": "wrangler d1 execute portfolio-events --remote --file schema.sql"
  },
  "dependencies": {
    "detect-browser": "^5.3.0",
    "isbot": "^5.2.3",
    "ua-parser-js": "1.0.41"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/ua-parser-js": "^0.7.39",
    "typescript": "^6.0.3",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261119.1": true
  }
}
